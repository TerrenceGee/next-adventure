{
  "paths": {
    "~/*": [
      "/*"
    ],
  },
  "include": [
    "./server"
  ],
  "exclude": [],
  "compilerOptions": {
    "isolatedModules": false,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "experimentalDecorators": true,
    "declarationMap": false,
    "resolveJsonModule": true,
    "declarationDir": "types/server",
    "moduleResolution": "node"
  }
}